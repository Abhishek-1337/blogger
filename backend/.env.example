OPENAI_API_KEY=sk-your-key-here
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
JWT_SECRET_KEY=generate-a-long-random-string
# JWT_EXPIRE_MINUTES=43200
# Rate limiting (Redis DB 2 by default; RATE_LIMIT_ENABLED=false disables it).
# Defaults: generation 10/min + 100/day per user, 100/min global;
# polling/reads 300/min per user, 6000/min global; admin reads 120/min
# per user, 1200/min global; login 20/min per IP, 1000/min global.
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/2
# RATE_LIMIT_GEN_PER_USER_PER_MINUTE=10
# RATE_LIMIT_GEN_PER_USER_PER_DAY=100
# RATE_LIMIT_GEN_GLOBAL_PER_MINUTE=100
# RATE_LIMIT_POLL_PER_USER_PER_MINUTE=300
# RATE_LIMIT_READ_PER_USER_PER_MINUTE=300
# RATE_LIMIT_ADMIN_PER_USER_PER_MINUTE=120
# RATE_LIMIT_LOGIN_PER_IP_PER_MINUTE=20
# RATE_LIMIT_FAIL_CLOSED=false
# Comma-separated admin emails allowed into the observability admin app.
# When unset, any signed-in user counts as admin (fine for local dev only).
# ADMIN_EMAILS=you@example.com,teammate@example.com
